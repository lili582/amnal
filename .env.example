# Copy to .env and fill in. Never commit .env.
LASTFM_API_KEY=
CONTACT_EMAIL=you@example.com
# User-Agent for outbound API calls, e.g. "AmnalBuilder/0.1 (you@example.com)"
USER_AGENT="AmnalBuilder/0.1 (${CONTACT_EMAIL})"

# Browser (Vite) settings
# Base URL the app fetches artists.json / schedule.json from at run time.
# Defaults to "/data" (same origin — works on any static host, incl. GitHub
# Pages). Point this at S3/elsewhere if the data lives on another origin.
VITE_DATA_URL=/data